<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <WasmMainJSPath>main.js</WasmMainJSPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RunAOTCompilation>false</RunAOTCompilation>  <!-- AOT compilation off for now, performance might be better with it on but beware of error from raylib-cs.dll -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <WasmBuildNative>true</WasmBuildNative>
    <WasmAllowUndefinedSymbols>true</WasmAllowUndefinedSymbols>
    
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <DefineConstants>$(DefineConstants);BROWSER</DefineConstants>

    <EmccFlags>$(EmccFlags) -sALLOW_MEMORY_GROWTH=1 -sINITIAL_MEMORY=64MB</EmccFlags>

    <!-- Link Optimization higher than -O1 causes build failure? This might be fixed in future versions of the dotnet workload.  -->
    <EmccCompileOptimizationFlag>-O3</EmccCompileOptimizationFlag>
    <EmccLinkOptimizationFlag>-O1</EmccLinkOptimizationFlag>
    <WasmNativeStrip>true</WasmNativeStrip>
    <WasmEmitSymbolMap>false</WasmEmitSymbolMap>

  </PropertyGroup>

  <!-- Raylib-cs.dll crashes when AOT compiled for WASM for some reason. This excludes it from that. -->
<!--  <ItemGroup>-->
<!--    <_AOT_InternalForceInterpretAssemblies Include="Raylib-cs.dll" />-->
<!--  </ItemGroup>-->

  <ItemGroup>
    <NativeFileReference Include="box2d.a" />
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
  </ItemGroup>

  <ItemGroup>
    <WasmExtraFilesToDeploy Include="index.html" />
    <WasmExtraFilesToDeploy Include="main.js" />
    <!--<WasmExtraFilesToDeploy Include="..\Raylib-cs\logo\raylib-cs.ico" TargetPath="favicon.ico"/>-->
    <WasmFilesToIncludeInFileSystem Include="..\GameLibrary\resource\**\*.*" TargetPath="resource\%(RecursiveDir)\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameLibrary\GameLibrary.csproj" />
  </ItemGroup>
</Project>
